# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Supabase, Transaction pooler (puerto 6543, con ?pgbouncer=true).
# Es la que usa la aplicación en funcionamiento.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase, Session pooler (puerto 5432).
# La usa Prisma para las migraciones. No usar la conexión directa db.xxxx.supabase.co: es IPv6 y falla en redes IPv4.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Clave de Resend con permiso de solo envío. Solo en el servidor.
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXX"

# Remitente del correo. Pruebas: onboarding@resend.dev. Producción: dominio verificado de la empresa.
MAIL_FROM="Registro de Asistencia <onboarding@resend.dev>"

# Correo que recibe los registros. Cambiar de pruebas a real sin tocar el código.
DESTINATARIO_ASISTENCIA="asistencia@ejemplo.com"

# Solo "live" envía correos reales. Cualquier otro valor, o no definirlo, es "test":
# no se envía nada y estadoCorreo queda en PENDIENTE. En producción hay que fijar live.
MAIL_MODE="test"
